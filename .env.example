# Telegram Bot Configuration
# Content bot: web access, approval, scheduling and administration
BOT_TOKEN=your_content_bot_token
# Media bot: video circles/reels and audio
MEDIA_BOT_TOKEN=your_media_bot_token
CONTENT_BOT_ID=0
MEDIA_BOT_ID=0
ADMIN_IDS=

# Default bot mode when BOT_MODE is not set explicitly
BOT_MODE=content

# HeyGen API
HEYGEN_API_KEY=your_heygen_api_key
# Set HEYGEN_TEST_MODE=true for watermarked free tests, or false for production
HEYGEN_TEST_MODE=false
# Voice id HeyGen. Empty blocks video render until a voice id is provided.
HEYGEN_DEFAULT_VOICE_ID=

# Your own avatar. See docs/CONNECT_YOUR_AVATAR.md
# Look id from HeyGen (my-avatars page or GET /v3/avatars/looks).
HEYGEN_AVATAR_ID=
# Optional "my avatars" group id; resolved to HEYGEN_AVATAR_ID automatically.
HEYGEN_AVATAR_GROUP_ID=
# digital_twin for a HeyGen digital twin, photo_avatar for a talking photo.
HEYGEN_AVATAR_TYPE=digital_twin
HEYGEN_AVATAR_NAME=Эксперт
HEYGEN_AVATAR_LOOK_NAME=Основной образ
HEYGEN_AVATAR_CATEGORY=live
# best (portrait 9:16) or other (landscape source, cropped in FFmpeg).
HEYGEN_AVATAR_STORIES_FIT=best
# Where the OAuth session is cached. Keep under ignored runtime storage.
HEYGEN_OAUTH_PATH=data/heygen_oauth.json

# MiniMax API
MINIMAX_API_KEY=
MINIMAX_GROUP_ID=

# Safety Limits
# Maximum words in text to fit a 60s Telegram Video Note and prevent extra credit billings
MAX_TEXT_WORDS=125
# Maximum words for a 9:16 reel
MAX_STORIES_TEXT_WORDS=200

# Storage paths
DB_PATH=data/bot.db
TEMP_DIR=temp

# Internal web panel
WEB_BASE_URL=http://localhost:8000
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
WEB_SESSION_SECRET=replace_with_a_long_random_secret
# Set false only for local HTTP development
WEB_COOKIE_SECURE=true
WEB_SESSION_DAYS=7

# Telegram user account via Telethon
TELEGRAM_API_ID=0
TELEGRAM_API_HASH=
TELEGRAM_PHONE=+70000000000
TELETHON_SESSION_PATH=data/telethon/content_account

# Text generation (OpenAI-compatible Chat Completions API)
CONTENT_LLM_BASE_URL=https://api.openai.com/v1
CONTENT_LLM_API_KEY=
CONTENT_LLM_MODEL=

# Telegram approval delivery
APPROVAL_USER_ID=0
SCHEDULER_INTERVAL_SECONDS=20
CONTENT_JOB_IDLE_SECONDS=2
WEEKLY_ENQUEUE_INTERVAL_SECONDS=900
METRICS_INTERVAL_SECONDS=900
